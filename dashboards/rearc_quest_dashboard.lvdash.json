                    },
                    {
                      "name": "series_title",
                      "expression": "`series_title`"
                    },
                    {
                      "name": "year",
                      "expression": "`year`"
                    },
                    {
                      "name": "yearly_sum",
                      "expression": "`yearly_sum`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
