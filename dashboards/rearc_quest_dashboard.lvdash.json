{
  "datasets": [
    {
      "name": "q1_pop_stats",
      "displayName": "Q1: Population Stats",
      "queryLines": [
        "SELECT mean_population, stddev_population FROM gold_q1_pop_stats"
      ]
    },
    {
      "name": "q2_best_year",
      "displayName": "Q2: Best Year per Series",
      "queryLines": [
        "SELECT series_id, series_title, year, yearly_sum FROM gold_q2_best_year ORDER BY yearly_sum DESC"
      ]
    },
    {
      "name": "q3_value_pop",
      "displayName": "Q3: PRS30006032 Q01 + Population",
      "queryLines": [
        "SELECT year, value, population FROM gold_q3_value_pop ORDER BY year"
      ]
    },
    {
      "name": "top_10_series",
      "displayName": "Top 10 Series by Yearly Sum",
      "queryLines": [
        "SELECT series_title, yearly_sum FROM gold_q2_best_year ORDER BY yearly_sum DESC LIMIT 10"
      ]
    },
    {
      "name": "population_trend",
      "displayName": "US Population Trend",
      "queryLines": [
        "SELECT year, population FROM gold_q3_value_pop WHERE population IS NOT NULL ORDER BY year"
      ]
    }
  ],
  "pages": [
    {
      "name": "rearc_data_quest",
      "displayName": "Rearc Data Quest",
      "layout": [
        {
          "widget": {
            "name": "mean_pop",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "q1_pop_stats",
                  "fields": [
                    {
                      "name": "mean_population",
                      "expression": "`mean_population`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "mean_population",
                  "displayName": "Mean US Population",
                  "format": {
                    "type": "number-plain",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Mean US Population (2013-2018)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "stddev_counter",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "q1_pop_stats",
                  "fields": [
                    {
                      "name": "stddev_population",
                      "expression": "`stddev_population`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "stddev_population",
                  "displayName": "StdDev US Population",
                  "format": {
                    "type": "number-plain",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 2
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "StdDev US Population (2013-2018)"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 0,
            "width": 6,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "q3_value_chart",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "q3_value_pop",
                  "fields": [
                    {
                      "name": "year",
                      "expression": "`year`"
                    },
                    {
                      "name": "value",
                      "expression": "`value`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "year",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Year"
                },
                "y": {
                  "fieldName": "value",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Value"
                }
              },
              "frame": {
                "showDescription": false,
                "showTitle": true,
                "title": "Q3: PRS30006032 Q01 value by year"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 6,
            "height": 7
          }
        },
        {
          "widget": {
            "name": "population_trend_chart",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "population_trend",
                  "fields": [
                    {
                      "name": "year",
                      "expression": "`year`"
                    },
                    {
                      "name": "population",
                      "expression": "`population`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "year",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Year"
                },
                "y": {
                  "fieldName": "population",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Population"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "US Population Trend (ACS 1-year; 2020 not published)"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 3,
            "width": 6,
            "height": 7
          }
        },
        {
          "widget": {
            "name": "top_10_bar",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "top_10_series",
                  "fields": [
                    {
                      "name": "series_title",
                      "expression": "`series_title`"
                    },
                    {
                      "name": "sum(yearly_sum)",
                      "expression": "SUM(`yearly_sum`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "sum(yearly_sum)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Yearly Sum"
                },
                "y": {
                  "fieldName": "series_title",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "x-reversed"
                    }
                  },
                  "displayName": "Series"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Top 10 Series by Yearly Sum"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 10,
            "width": 12,
            "height": 7
          }
        },
        {
          "widget": {
            "name": "best_year_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "q2_best_year",
                  "fields": [
                    {
                      "name": "series_id",
